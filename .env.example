# Port on which the Qavora server listens (default: 3000, cloud hosts inject dynamically)
PORT=3000

# Node.js environment mode: development | production
NODE_ENV=production

# MongoDB Atlas connection string placeholder
MONGODB_URI=

# MongoDB database name (default: qavora)
MONGODB_DB=qavora

# JSON Web Token secret key (minimum 32 random characters recommended)
JWT_SECRET=your_secure_random_secret_here

# JWT expiration duration (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Base path for static assets when hosting on a subpath or CDN (e.g. / or /qavora/)
VITE_BASE_PATH=/

# Optional: Remote backend API URL for decoupled frontend hosting (deferred to later step)
# VITE_API_URL=https://api.yourdomain.com

